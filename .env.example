# ─────────────────────────────────────────────────────────────
# Commerce provider
#   demo    (default) local catalog + simulated checkout, no credentials
#   shopify Storefront API — only activates when the vars below are set
# ─────────────────────────────────────────────────────────────
COMMERCE_PROVIDER=demo

# ── Shopify Storefront API (server-side only; never prefix with NEXT_PUBLIC_) ──
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Prefer the private Storefront token (Headless channel → Storefront API → private access token)
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# ...or the public Storefront token
# SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# SHOPIFY_STOREFRONT_API_VERSION=2026-10
# Storefront search query selecting which products hang on the rack
# SHOPIFY_RACK_QUERY=tag:rack
